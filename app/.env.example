# Copy to app/.env.local (gitignored). Vite inlines every VITE_* value into the
# built bundle, so nothing here can be secret — a Firebase web config is public
# by design and security comes from the rules, not from hiding it. What is kept
# out of git is the BINDING between this source tree and one deployment.

# --- Local development ------------------------------------------------------
# demo- project ids are emulator-only: Firebase refuses to point them at a real
# backend, so the quickstart cannot write to production even by accident.
VITE_USE_EMULATORS=1
VITE_FIREBASE_PROJECT_ID=demo-bikeshed
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-bikeshed.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=demo-bikeshed-content
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_DATABASE_URL=http://127.0.0.1:9000?ns=demo-bikeshed

# --- Analytics (optional) ---------------------------------------------------
# Analytics initializes ONLY when this is set, and never under emulators. Leave
# it empty and there is no gtag request and no cookie. See SPEC §15.
VITE_FIREBASE_MEASUREMENT_ID=

# --- Landing explainer (optional) -------------------------------------------
# Direct HTTPS media revision emitted by scripts/media.mjs publish. Requires
# the separate mediaBucket in config/deploy.json. Empty hides the video; the
# written introduction remains available. Keep the deployment URL out of git.
VITE_LANDING_MEDIA_BASE_URL=

# --- Export marking defaults (optional) -------------------------------------
# Seeds each new account's default, which in turn seeds each new document. Empty
# means exports carry no marking, which is the default. See SPEC §20.
VITE_EXPORT_MARK_ENABLED=
VITE_EXPORT_MARK_LABEL=
VITE_EXPORT_MARK_FOOTER=

# --- Legal pages ------------------------------------------------------------
# Who to contact about /terms and /privacy. Those documents describe THIS
# deployment's handling of data, so the address is the operator's. Unset, the
# pages say no contact is published rather than inventing one.
VITE_LEGAL_CONTACT=
