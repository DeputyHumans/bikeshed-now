# Copy to functions/.env (gitignored). Names only — no values are committed.
#
# NOTE: the Resend API key is deliberately NOT here. It is a Firebase secret
# (`defineSecret`), set with:
#
#     firebase functions:secrets:set RESEND_API_KEY
#
# so it never touches disk. Email is optional: with no key configured every send
# is a logged no-op and the app behaves exactly as it does with one. That is the
# path CI exercises.

# The private content bucket. Resolution order is BIKESHED_BUCKET, then
# config/deploy.json, then a derived `${projectId}-content`. The Firebase default
# bucket is never assumed: `${projectId}.appspot.com` is wrong for projects
# created after 2024 and `.firebasestorage.app` is wrong for those created
# before, so guessing silently writes to a bucket nobody reads.
BIKESHED_BUCKET=

# Public origin, used to build links in email and in sitemap.xml.
BIKESHED_PUBLIC_ORIGIN=

# One sentence shown to someone the deployment's allowlist rejected. It is
# returned by GET /config. The allowlist itself is never sent to a client.
BIKESHED_SIGN_IN_HINT=
