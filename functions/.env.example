# Copy to functions/.env (gitignored). Names only — no values are committed.
#
# NOTE: the Resend API key is deliberately NOT here. It is a Firebase secret
# (`defineSecret`), set with:
#
#     firebase functions:secrets:set RESEND_API_KEY
#
# so it never touches disk. Email is optional: with no key configured every send
# is a logged no-op and the app behaves exactly as it does with one. That is the
# path CI exercises.

# The private content bucket. Resolution order is BIKESHED_BUCKET, then
# config/deploy.json, then a derived `${projectId}-content`. The Firebase default
# bucket is never assumed: `${projectId}.appspot.com` is wrong for projects
# created after 2024 and `.firebasestorage.app` is wrong for those created
# before, so guessing silently writes to a bucket nobody reads.
#
# Under the emulator it belongs in functions/.env.local, as
#   BIKESHED_BUCKET=demo-bikeshed-content
# — this file's copy (functions/.env) may name the real content bucket on a
# deployer's machine; without the .local override contentProxy reads a bucket
# the walkthrough's publish.mjs never wrote to, and every asset 404s.
BIKESHED_BUCKET=

# Public origin, used to build links in email and in sitemap.xml, and the
# origin the document page (docShell) fetches the app shell from at runtime.
# Set it explicitly: the fallback is the default site's .web.app host, which
# is the app only when the site id equals the project id, and the shell fetch
# fails closed on anything that is not the app (every /d/** answers 503).
#
# Under the emulator it belongs in functions/.env.local, as
#   BIKESHED_PUBLIC_ORIGIN=http://127.0.0.1:5050
# — an emulator-only override, loaded last and only by the emulator. This
# file's copy (functions/.env) may hold the production origin on a deployer's
# machine; without the .local override the emulator would fetch the production
# shell.
BIKESHED_PUBLIC_ORIGIN=

# The address email is sent FROM, e.g. `Bikeshed <noreply@example.com>`.
#
# Deliberately separate from BIKESHED_PUBLIC_ORIGIN: the domain you SERVE from
# and the one you may SEND from are usually not the same, and nobody can verify
# a *.web.app domain with an email provider. Unset, it falls back to
# noreply@<public origin host>, which is right only when you serve from the
# domain you have verified.
BIKESHED_MAIL_FROM=

# One sentence shown to someone the deployment's allowlist rejected. It is
# returned by GET /config. The allowlist itself is never sent to a client.
BIKESHED_SIGN_IN_HINT=

# Who may trust a document for everyone, so its scripts run for every reader
# (ADR 0021): addresses separated by commas, and only on documents they own.
# Everyone else's documents run their scripts only for a reader who chooses
# to. Unset means nobody may. Never commit the addresses.
BIKESHED_SUPERADMINS=

# Identity issuers trusted to connect an app for one of this deployment's
# people with no consent page (ADR 0026), such as a Claude workspace's
# "Claude-issued" managed authorization: exact https issuer URLs, separated by
# commas or spaces, copied byte for byte from Claude's admin dialog (a trailing
# slash makes it a different issuer). The account behind each address must
# already exist here; an assertion never creates one. Unset means none, and the
# grant is neither accepted nor advertised. Never commit a real one: its id
# names the organisation, and check:secrets refuses the shape. For a Claude
# workspace it looks like this:
#
#   BIKESHED_ID_JAG_ISSUERS=https://identity.anthropic.com/issuers/iss_<workspace id>
#
# docs/operations/overview.md "Letting an organisation connect its people's
# apps" walks through setting it, checking it and reading its log lines.
BIKESHED_ID_JAG_ISSUERS=

# The address domains those issuers may vouch for, separated by commas or
# spaces (a leading @ and case are ignored): an assertion's address must be at
# one of them exactly. REQUIRED with BIKESHED_ID_JAG_ISSUERS: unset means none,
# and the grant is then off, because an issuer trusted for every domain could
# connect any account here, an administrator's included.
#
#   BIKESHED_ID_JAG_DOMAINS=example.com,example.org
BIKESHED_ID_JAG_DOMAINS=
