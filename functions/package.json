{
  "name": "bikeshed-now-functions",
  "version": "0.33.1",
  "private": true,
  "license": "Apache-2.0",
  "description": "Cloud Functions (v2): every server-side decision — auth, ACL, content proxy, versioning, Markdown compilation, provenance, teams, email, MCP.",
  "main": "lib/index.js",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions --project demo-bikeshed",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@react-email/components": "^0.0.25",
    "@react-email/render": "^1.0.2",
    "adm-zip": "^0.6.1",
    "cookie": "^0.7.2",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.0",
    "markdown-it": "14.3.3",
    "mime-types": "^2.1.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^4.0.1",
    "turndown": "7.2.0",
    "turndown-plugin-gfm": "1.0.2"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.6.0",
    "@types/cookie": "^0.6.0",
    "@types/markdown-it": "^14.1.2",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^24.19.1",
    "@types/react": "^18.3.11",
    "@types/turndown": "^5.0.5",
    "typescript": "^5.6.2"
  }
}
