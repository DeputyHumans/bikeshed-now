{
  "name": "bikeshed-now-functions",
  "version": "0.33.1",
  "private": true,
  "license": "Apache-2.0",
  "description": "Cloud Functions (v2): every server-side decision — auth, ACL, content proxy, versioning, Markdown compilation, provenance, teams, email, MCP.",
  "main": "lib/index.js",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions --project demo-bikeshed",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.2.0",
    "adm-zip": "^0.6.1",
    "cookie": "^2.0.1",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "markdown-it": "14.3.3",
    "mime-types": "^3.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.37.0",
    "turndown": "7.2.0",
    "turndown-plugin-gfm": "1.0.2"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.6.0",
    "@types/cookie": "^1.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/turndown": "^5.0.5",
    "typescript": "^7.0.2"
  }
}
