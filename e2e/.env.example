# Variable NAMES for the e2e suite. Values never go in this file.
# Real production values live in gitignored e2e/.env.prod (see e2e/README.md).

# --- Production tier (not implemented in this build; names fixed by the plan) ---
# The deployment's public origin, its Firebase project id, and the operator
# account whose ADC the production tier must run as.
E2E_ORIGIN=
E2E_PROJECT_ID=
E2E_OPERATOR_ACCOUNT=
# Must equal the host of E2E_ORIGIN for `--target prod` to run at all.
E2E_CONFIRM_ORIGIN=

# --- Local tier: optional overrides ------------------------------------------
# Node 24 bin directory (or node binary) the stack runs under; default is the
# newest ~/.nvm/versions/node/v24.*.
E2E_NODE_BIN=
# Extra ports a stack must never take, e.g. 31000,32000-32015.
E2E_DENY_PORTS=
# Tool paths when they are not on PATH.
E2E_FIREBASE_BIN=
E2E_MAILPIT_BIN=
E2E_JAVA_BIN=
# Chrome for the browser specs (default: playwright channel "chrome").
E2E_CHROME=

# --- Set by e2e/run.mjs for spec processes; never set by hand ----------------
E2E_TARGET=
E2E_RUN_ID=
E2E_SUITE=
E2E_N=
