{
  "name": "bikeshed-now-source",
  "version": "0.36.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Versioned document publishing with highlight-anchored feedback, collaborative review, and an agent-facing publishing API.",
  "homepage": "https://bikeshed.now",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeputyHumans/bikeshed-now.git"
  },
  "bugs": {
    "url": "https://github.com/DeputyHumans/bikeshed-now/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:policy": "node tools/build-policy.mjs",
    "check:policy": "node tools/build-policy.mjs --check",
    "check:secrets": "./scripts/check-secrets.sh",
    "check:headers": "node scripts/check-headers.mjs",
    "check:agents": "node tools/build-agents.mjs --check",
    "build:agents": "node tools/build-agents.mjs",
    "setup": "node scripts/setup.mjs",
    "teardown": "node scripts/teardown.mjs",
    "publish:doc": "node scripts/publish.mjs",
    "delete-version": "node scripts/delete-version.mjs",
    "access": "node scripts/set-access.mjs",
    "prebuild": "npm run check:policy",
    "build": "npm run build:app && npm run build:functions",
    "build:app": "npm --prefix app run build",
    "build:functions": "npm --prefix functions run build",
    "install:all": "npm install && npm --prefix app install && npm --prefix functions install",
    "emulators": "firebase emulators:start --project demo-bikeshed",
    "pretest": "npm run check:policy",
    "test": "npm run test:tools && npm run test:functions && npm run test:app && npm run test:cli",
    "pretest:tools": "node tools/ensure-rtdb-test-fixture.mjs",
    "test:tools": "node --test $BIKESHED_NODE_TEST_FLAGS tools/*.test.mjs",
    "test:functions": "npm --prefix functions test",
    "test:app": "npm --prefix app run coverage",
    "test:cli": "cd cli && node --test $BIKESHED_NODE_TEST_FLAGS test/*.test.mjs",
    "test:rules": "node --test $BIKESHED_NODE_TEST_FLAGS rules-tests/*.test.mjs",
    "test:e2e": "node e2e/run.mjs",
    "test:rules:emulated": "firebase emulators:exec --only firestore,database --project demo-bikeshed \"npm run test:rules\"",
    "verify": "npm run check:policy && npm run check:agents && npm run build && npm run test && npm run check:secrets && npm run check:headers && npm run check:content && npm run check:licenses",
    "check:content": "node scripts/check-content.mjs",
    "check:licenses": "node tools/check-licenses.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.14.1",
    "firebase-admin": "^12.7.0",
    "mime": "^4.1.2",
    "playwright-core": "1.65.0"
  },
  "overrides": {
    "undici": "^6.29.1",
    "@grpc/grpc-js": "^1.14.7",
    "uuid": "^11.1.1"
  }
}
