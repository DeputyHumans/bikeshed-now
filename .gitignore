# ---------------------------------------------------------------------------
# Deployment bindings — NEVER COMMIT.
#
# The code in this repository is deployment-agnostic. The facts that bind it to
# one particular Firebase project (project id, console account, storage bucket,
# Web SDK config, API keys, measurement id) live only in the files below and in
# Firebase's secret manager. Everything tracked uses placeholders, or the
# emulator-only `demo-bikeshed` id, which Firebase refuses to point at a real
# backend. See docs/operations/overview.md.
# ---------------------------------------------------------------------------
.firebaserc
config/deploy.json
DEPLOYMENT.local.md
.env
.env.*
!.env.example
app/.env
app/.env.*
!app/.env.example
functions/.env
functions/.env.*
!functions/.env.example
service-account*.json
*.serviceaccount.json

# Build products. Deterministic, regenerated by `npm run build`, and committing
# them would put a minified copy of every source string into the tree.
node_modules/
**/node_modules/
dist/
app/dist/
functions/lib/
cli/lib/
*.tsbuildinfo
coverage/

# Firebase tooling
.firebase/
*-debug.log
*.log

# Editor and OS
.DS_Store
*.bak
.idea/
.vscode/

# Claude Code — personal-only settings
.claude/settings.local.json
.mcp.json

# Copied into the published CLI tarball by its prepack, never committed
cli/LICENSE
cli/NOTICE
*.tgz
