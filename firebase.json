{
  "hosting": {
    "public": "app/dist",
    "predeploy": ["node tools/stamp-deployment.mjs --check"],
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/session", "function": "session" },
      { "source": "/config", "function": "appConfig" },
      { "source": "/access", "function": "setAccess" },
      { "source": "/publish", "function": "createDoc" },
      { "source": "/folder", "function": "createFolder" },
      { "source": "/folder-access", "function": "setFolderAccess" },
      { "source": "/organize", "function": "organize" },
      { "source": "/fork", "function": "forkDoc" },
      { "source": "/trust", "function": "trustDoc" },
      { "source": "/marking", "function": "setMarking" },
      { "source": "/visibility", "function": "setVisibility" },
      { "source": "/team", "function": "manageTeam" },
      { "source": "/team-members", "function": "manageTeamMembers" },
      { "source": "/tokens", "function": "manageTokens" },
      { "source": "/view", "function": "recordView" },
      { "source": "/unlock", "function": "unlockDoc" },
      { "source": "/draft", "function": "saveDraft" },
      { "source": "/commit", "function": "commitVersion" },
      { "source": "/mcp", "function": "mcp" },
      { "source": "/sitemap.xml", "function": "sitemap" },
      { "source": "/verify/**", "function": "verifyEmail" },
      { "source": "/download/**", "function": "downloadBundle" },
      { "source": "/draft/**", "function": "getDraft" },
      { "source": "/content/**", "function": "contentProxy" },
      { "source": "/d/**", "function": "docShell" },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "/content/**",
        "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }]
      },
      {
        "source": "/draft/**",
        "headers": [
          { "key": "Cache-Control", "value": "private, no-store" },
          { "key": "X-Content-Type-Options", "value": "nosniff" }
        ]
      },
      {
        "source": "/download/**",
        "headers": [{ "key": "Cache-Control", "value": "private, no-store" }]
      },
      {
        "source": "/assets/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "/fonts/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20",
    "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8088 },
    "database": { "port": 9000 },
    "functions": { "port": 5001 },
    "hosting": { "port": 5050 },
    "storage": { "port": 9199 },
    "ui": { "enabled": true, "port": 4040 },
    "singleProjectMode": true
  }
}
