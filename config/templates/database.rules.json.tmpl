@@BANNER@@
//
// Realtime Database security rules (SPEC §6b, §16).
//
// RTDB carries ephemeral collaboration state — who is here, where they are
// looking, and the live merge of the document everyone is typing into. The
// `lock` and `requests` nodes an earlier design used are withdrawn along with
// the edit lock itself (ADR 0010); anything still writing them is rejected by
// the `$other` rule below, which is the point of having one. None of
// it is the durable artifact: the draft and the published versions live in
// Firestore and Storage, and everything here disappears when the last tab
// closes.
//
// The read gate is the interesting part. RTDB rules cannot query Firestore, so
// the authorization data has to live IN RTDB: `presenceAccess/{docId}/{emailKey}`
// is a server-maintained mirror of each doc's member list, written by the same
// six code paths that already recompute `members`. It is keyed by EMAIL rather
// than uid because the server does not learn a grantee's uid until they first
// sign in, and a share must work the moment it is granted.
//
// It fails CLOSED: a missing mirror entry means presence goes dark for that
// document, never that a stranger can read it. Without this gate, any signed-in
// account could walk the slug space and learn who reads what — and since a live
// selection stream reveals what someone is reading sentence by sentence, that is
// considerably more than a name.
//
// `editAccess/{docId}/*` is how a PUBLIC open-editing document says "any
// verified account". `publicEdit` widens who may edit to accounts that are by
// definition not in `editorMembers`, and `*` is safe as a key precisely because
// it is not a legal address: the validator rejects it, so it cannot collide with
// a person. An UNLISTED open-editing document never gets it: these rules cannot
// see a link's key, so `*` there would let any account write into a document it
// cannot even name. Its link holders edit through /draft, which can (SPEC §16).
//
// `editAccess/{docId}` is the SECOND mirror, of `editorMembers`, and it exists
// because `status/{docId}/y` carries shared document state (SPEC §6b). Gating
// that on `presenceAccess` would let a read-only member push edits into an
// editor's browser, which that editor then autosaves and publishes: read
// escalated to write through a channel nobody would think to audit. Presence is
// gated on "may read"; document state reads and writes are gated on "may edit".
// The server mirrors __expiresAt (epoch ms, zero means no expiry) and __owner.
// At expiry only the owner may read; nobody may change the CRDT. Legacy nodes
// without metadata keep their previous behavior until their next mirror sync.
// The public wildcard admits /y only, never another reader's presence.
//
// emailKey = the lowercased address with every '.' replaced by ','. Dots are
// illegal in RTDB keys; the four other illegal characters ($ # [ ] /) are
// rejected by the email validator in config/policy.mjs, so every address the
// system stores is representable here.
{
  "rules": {
    ".read": false,
    ".write": false,

    "status": {
      "$docId": {
        "peers": {
          ".read": "auth != null && auth.token.email_verified == true && auth.token.email != null && @@POLICY@@ && root.child('presenceAccess').child($docId).child(auth.token.email.toLowerCase().replace('.', ',')).val() == true && ((!root.child('presenceAccess').child($docId).child('__expiresAt').exists() || (root.child('presenceAccess').child($docId).child('__expiresAt').isNumber() && (root.child('presenceAccess').child($docId).child('__expiresAt').val() == 0 || root.child('presenceAccess').child($docId).child('__expiresAt').val() > now))) || root.child('presenceAccess').child($docId).child('__owner').val() == auth.token.email.toLowerCase())",
          "$session": {
            // A departed session may delete only its own record, even after
            // revocation/expiry. Updates still require current read access.
            ".write": "auth != null && ((!newData.exists() && ((data.child('uid').exists() && data.child('uid').val() == auth.uid) || (!data.child('uid').exists() && $session == auth.uid))) || (newData.exists() && (!data.exists() || ((data.child('uid').exists() && data.child('uid').val() == auth.uid) || (!data.child('uid').exists() && $session == auth.uid))) && (newData.child('uid').val() == auth.uid || (!newData.child('uid').exists() && $session == auth.uid)) && auth != null && auth.token.email_verified == true && auth.token.email != null && @@POLICY@@ && root.child('presenceAccess').child($docId).child(auth.token.email.toLowerCase().replace('.', ',')).val() == true && ((!root.child('presenceAccess').child($docId).child('__expiresAt').exists() || (root.child('presenceAccess').child($docId).child('__expiresAt').isNumber() && (root.child('presenceAccess').child($docId).child('__expiresAt').val() == 0 || root.child('presenceAccess').child($docId).child('__expiresAt').val() > now))) || root.child('presenceAccess').child($docId).child('__owner').val() == auth.token.email.toLowerCase())))",
            ".validate": "newData.hasChildren(['email', 'mode', 'lastChanged']) && newData.child('email').val() == auth.token.email.toLowerCase() && newData.child('mode').isString() && (newData.child('mode').val() == 'view' || newData.child('mode').val() == 'edit') && newData.child('lastChanged').val() == now && (newData.child('mode').val() != 'edit' || ((newData.child('liveEpoch').val() == root.child('editAccess').child($docId).child('__liveEpoch').val() || ((!newData.child('liveEpoch').exists() || newData.child('liveEpoch').val() == 'initial') && (!root.child('editAccess').child($docId).child('__liveEpoch').exists() || root.child('editAccess').child($docId).child('__liveEpoch').val() == 'initial'))) && (root.child('editAccess').child($docId).child(auth.token.email.toLowerCase().replace('.', ',')).val() == true || root.child('editAccess').child($docId).child('*').val() == true) && (!root.child('editAccess').child($docId).child('__expiresAt').exists() || (root.child('editAccess').child($docId).child('__expiresAt').isNumber() && (root.child('editAccess').child($docId).child('__expiresAt').val() == 0 || root.child('editAccess').child($docId).child('__expiresAt').val() > now)))))",

            // Every child needs its own rule: `$other` below matches ANY key
            // not explicitly named, so omitting one here rejects the whole
            // write rather than merely leaving it unvalidated.
            "liveEpoch": { ".validate": "newData.isString() && newData.val().length <= 80" },
            "uid": { ".validate": "newData.isString() && newData.val() == auth.uid" },
            "email": { ".validate": "newData.isString() && newData.val().length <= 254" },
            "mode": { ".validate": "newData.isString()" },
            "lastChanged": { ".validate": "newData.isNumber()" },
            "name": { ".validate": "newData.isString() && newData.val().length <= 120" },

            "focus": {
              ".validate": "newData.hasChildren(['exact'])",
              "elementId": { ".validate": "newData.isString() && newData.val().length <= 200" },
              "exact": { ".validate": "newData.isString() && newData.val().length <= 600" },
              "prefix": { ".validate": "newData.isString() && newData.val().length <= 200" },
              "suffix": { ".validate": "newData.isString() && newData.val().length <= 200" },
              "start": { ".validate": "newData.isNumber() && newData.val() >= 0" },
              "end": { ".validate": "newData.isNumber() && newData.val() >= 0" },
              "$other": { ".validate": false }
            },

            "viewport": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },

            "composing": { ".validate": "newData.isString() && newData.val().length <= 200" },

            "$other": { ".validate": false }
          }
        },

        // Shared document state: an append-only log of CRDT updates, each a
        // base64 Yjs update. Order does not matter — that is the whole point of
        // a CRDT — so a push id is enough and no client needs to coordinate.
        //
        // Entries are DELETABLE by any editor, because compaction replaces a
        // run of updates with one merged update and must remove what it
        // merged. Deleting a log entry cannot lose a document: every peer has
        // already applied it, and the durable copy is the saved draft.
        "y": {
          ".read": "auth != null && auth.token.email_verified == true && auth.token.email != null && @@POLICY@@ && (root.child('editAccess').child($docId).child(auth.token.email.toLowerCase().replace('.', ',')).val() == true || root.child('editAccess').child($docId).child('*').val() == true) && ((!root.child('editAccess').child($docId).child('__expiresAt').exists() || (root.child('editAccess').child($docId).child('__expiresAt').isNumber() && (root.child('editAccess').child($docId).child('__expiresAt').val() == 0 || root.child('editAccess').child($docId).child('__expiresAt').val() > now))) || root.child('editAccess').child($docId).child('__owner').val() == auth.token.email.toLowerCase())",
          "$epoch": {
            // Only this epoch is retired; a newer publication has its own tree.
            ".write": "auth != null && auth.token.email_verified == true && auth.token.email != null && @@POLICY@@ && (root.child('editAccess').child($docId).child(auth.token.email.toLowerCase().replace('.', ',')).val() == true || root.child('editAccess').child($docId).child('*').val() == true) && (!root.child('editAccess').child($docId).child('__expiresAt').exists() || (root.child('editAccess').child($docId).child('__expiresAt').isNumber() && (root.child('editAccess').child($docId).child('__expiresAt').val() == 0 || root.child('editAccess').child($docId).child('__expiresAt').val() > now))) && !newData.exists()",
            "$entry": {
              ".write": "auth != null && auth.token.email_verified == true && auth.token.email != null && @@POLICY@@ && (root.child('editAccess').child($docId).child(auth.token.email.toLowerCase().replace('.', ',')).val() == true || root.child('editAccess').child($docId).child('*').val() == true) && (!root.child('editAccess').child($docId).child('__expiresAt').exists() || (root.child('editAccess').child($docId).child('__expiresAt').isNumber() && (root.child('editAccess').child($docId).child('__expiresAt').val() == 0 || root.child('editAccess').child($docId).child('__expiresAt').val() > now))) && (root.child('editAccess').child($docId).child('__liveEpoch').val() == $epoch || (!root.child('editAccess').child($docId).child('__liveEpoch').exists() && $epoch == 'initial')) && ($entry != '_seed' || !data.exists() || newData.val() == data.val())",
              ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 200000)"
            }
          }
        },

        "$other": { ".validate": false }
      }
    },

    "presenceAccess": {
      ".read": false,
      ".write": false
    },

    "editAccess": {
      ".read": false,
      ".write": false
    }
  }
}
