rules_version = '2';

// GENERATED — DO NOT EDIT.
// Rendered by tools/build-policy.mjs from config/access-policy.json.
// Edit the source and run `npm run build:policy`; CI byte-compares this file.
// source sha256: 309f8413ff70f3c681cc9cc5f947062d3ecdce61128e827ebc23152f4ee6b40c
//
// Firestore security rules (SPEC §1, §4, §13, §17, §18).
//
// Identity gate: signed in, email verified, and — only when the deployment
// configures one — inside the domain allowlist. There is no built-in domain
// restriction; the per-doc owner+member ACL is the access control.
//
// Access gate: doc owner (by uid) OR email present in the doc's `members` list.
// `members` is the EFFECTIVE read set, maintained server-side: the owner, direct
// grants, grants inherited from parent folders, and team grants expanded to the
// people in them. Keeping it a flat array of lowercased emails is what lets the
// `list` rule below be statically provable from the query's array-contains
// filter — rules are not filters, so a transformed expression would make the
// whole workspace query undeniable-or-unusable.
//
// All doc/version/folder/team writes are server-side (Admin SDK) only. Clients
// may only create and edit their own annotations, comments, personal trust and
// user record.

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Identity ---------------------------------------------------------

    // `email is string` is not redundant. A custom token can carry
    // `email_verified: true` with no `email` claim at all; without this
    // conjunct that principal reaches the member checks below, where it would
    // deny only by accident. Make the requirement explicit and test it.
    function isVerifiedUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function docData(docId) {
      return get(/databases/$(database)/documents/docs/$(docId)).data;
    }

    // --- Document access --------------------------------------------------

    /** Default and private-equivalent: absent `visibility` means private. */
    function isNonPrivate(d) {
      return d.visibility is string
        && (d.visibility == 'public' || d.visibility == 'unlisted');
    }

    function isMember(d) {
      return isVerifiedUser()
        && (request.auth.uid == d.ownerUid
            || (d.members is list && myEmail() in d.members));
    }

    // An UNLISTED document needs its link, and these rules cannot see a URL.
    // So a signed-in visitor who opens it with the key gets a link grant from
    // POST /unlock, naming the token they presented. It counts only while that
    // is still the document's token: rotating the link revokes every grant
    // without touching one. `get()` here is not subject to the grant's own
    // rule, which denies every client read (SPEC §17).
    function linkGrant(docId) {
      return /databases/$(database)/documents/docs/$(docId)/linkGrants/$(request.auth.uid);
    }

    function hasLinkGrant(docId, d) {
      return isVerifiedUser()
        && d.get('visibility', '') == 'unlisted'
        && d.get('linkToken', null) is string
        && exists(linkGrant(docId))
        && get(linkGrant(docId)).data.token == d.linkToken;
    }

    // Everything a client reads DIRECTLY under docs/** requires an account,
    // even on a public document. These records carry member lists and reviewer
    // identities; publishing a document must not publish the people who read
    // and annotated it. An anonymous reader gets the world-readable
    // public/{docId} projection of a PUBLIC document, the reader projection of
    // an unlisted one from POST /unlock with its key, the bytes through
    // contentProxy, and nothing else. Mirrors functions/src/lib/acl.ts
    // readBasis(), for a caller with an account (SPEC §17).
    function canRead(docId, d) {
      return isMember(d)
        || (isVerifiedUser()
            && !isTrashed(d)
            && (d.get('visibility', '') == 'public' || hasLinkGrant(docId, d)));
    }

    // In the Trash (SPEC §4). Its derived sets hold its owner alone, so
    // membership already shuts everyone else out; this closes the ways in
    // that are not membership (public, a link grant) and the direct grant
    // lists, which are kept on the record for Restore. Restore writes null.
    // Mirrors functions/src/lib/acl.ts isTrashed().
    function isTrashed(d) {
      return d.get('trashed', null) is map;
    }

    // Expiry and the Trash freeze every feedback mutation, including the
    // owner's. Keep this separate from canRead: workspace queries and existing
    // feedback remain readable under their normal membership policy (SPEC §4,
    // §17).
    function feedbackWritable(d) {
      return !isTrashed(d)
        && (d.get('expiresAt', null) == null || d.expiresAt > request.time);
    }

    // The real editor set: owner, direct editors, or effective/inherited
    // editors (folder and team grants, expanded server-side). Mirrors
    // functions/src/lib/acl.ts isDocEditor(). This — not canEdit — gates the
    // per-person usage stats, because open editing on a public doc must not
    // hand a stranger the reading history of everyone who opened it.
    function isDocEditor(d) {
      return isVerifiedUser()
        && (request.auth.uid == d.ownerUid
            || myEmail() == d.ownerEmail
            || (!isTrashed(d)
                && ((d.editors is list && myEmail() in d.editors)
                    || (d.approvers is list && myEmail() in d.approvers)
                    || (d.editorMembers is list && myEmail() in d.editorMembers))));
    }

    // `publicEdit` widens WHO MAY EDIT to "any verified account" among those
    // who may read — on an unlisted document, only the holders of its link. It
    // never relaxes isVerifiedUser(), so anonymous stays read-only everywhere.
    // Mirrors functions/src/lib/acl.ts canEdit().
    function canEdit(docId, d) {
      return isDocEditor(d)
        || (isNonPrivate(d) && d.get('publicEdit', false) == true && canRead(docId, d));
    }

    // Author fields must match the caller. The actor's `channel` is pinned to
    // 'web' here because a direct client write IS the web channel by
    // definition — automation writes arrive through the Admin SDK, which
    // bypasses these rules entirely. That is what makes `channel` server-
    // derived rather than self-reported (SPEC §17).
    function authoredBySelf() {
      return request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorEmail == myEmail()
        && request.resource.data.actor.uid == request.auth.uid
        && request.resource.data.actor.email == myEmail()
        && request.resource.data.actor.channel == 'web'
        && request.resource.data.actor.keys().hasOnly(['uid', 'email', 'channel']);
    }

    // Exactly the fields the app writes, stamped with the server's clock.
    // Without the list a client could put any `actor.tokenId`, `client` or
    // `agent` on its own feedback (the forensic primitive, SPEC §17), date it
    // whenever it liked, or leave `resolved` out, and a thread without it
    // escapes every `resolved == false` count, the commit gate's included.
    function isExactly(keys) {
      return request.resource.data.keys().hasOnly(keys)
        && request.resource.data.keys().hasAll(keys);
    }

    match /docs/{docId} {
      // get: evaluated against the concrete document, so the member check can
      // be case-insensitive. Member-only even for a public doc — the record
      // carries members/viewers/editors/ownerEmail/stats and Firestore rules
      // cannot project fields.
      allow get: if isMember(resource.data);

      // list: the workspace query is `members array-contains <myEmail> orderBy
      // createdAt desc`. A list rule must be statically provable from the query
      // constraints, so it cannot use a transformed expression like
      // email.lower(); a direct membership comparison matches the
      // array-contains filter exactly. Members are stored lowercased
      // (invariant), so this is exact rather than merely close.
      allow list: if isVerifiedUser()
        && request.auth.token.email in resource.data.members;

      allow write: if false; // Admin SDK only (endpoints + admin CLIs)

      // Link grants: minted by POST /unlock on seeing an unlisted document's
      // key, and read only by the rules above. A client that could read one
      // would learn who opened the link; one that could write one would not
      // need the link at all.
      match /linkGrants/{uid} {
        allow read, write: if false;
      }

      // PERSONAL trust (SPEC §6c). Lifting the sandbox for EVERYONE stays
      // owner-only through POST /trust. This subcollection is the per-account
      // opt-in: it un-sandboxes the bundle only in the granting user's own
      // browser, so the sole session exposed to that bundle's JS is theirs.
      // Because the decision is self-regarding, any reader may make it for
      // themselves. It never touches ACL, content, or another user's
      // rendering. Read is self-only: nobody needs to know who else opted in.
      match /trust/{uid} {
        allow read: if isVerifiedUser() && request.auth.uid == uid;
        allow create, update: if canRead(docId, docData(docId))
          && !isTrashed(docData(docId))
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.email == myEmail();
        allow delete: if isVerifiedUser() && request.auth.uid == uid;
      }

      // Usage stats (SPEC §4). The AGGREGATE lives on the doc itself, so every
      // member sees it. The per-person breakdown is editor-gated.
      match /viewers/{uid} {
        allow read: if isDocEditor(docData(docId));
        allow write: if false; // recordView, via the Admin SDK
      }
      match /views/{sessionId} {
        allow read: if isDocEditor(docData(docId));
        allow write: if false; // recordView, via the Admin SDK
      }

      // ACL change log — the provenance record for "who granted whom access,
      // from where" (SPEC §17). Append-only, server-written.
      match /acl/{entryId} {
        allow read: if isDocEditor(docData(docId));
        allow write: if false;
      }

      match /versions/{versionId} {
        allow read: if canRead(docId, docData(docId));
        allow write: if false; // immutable; minted server-side only

        // A SUGGESTION is an annotation with a `suggestion` field (SPEC §22).
        // No client write may create, change or remove one: who may suggest,
        // and who may decide, are roles the rules cannot see without reading
        // four more arrays, so `POST /suggestion` is the only path and these
        // clauses close every other. Without them a reader could forge a
        // suggestion, or set `resolved` on one and lift the publish gate
        // without anybody deciding it.
        match /annotations/{annId} {
          allow read: if canRead(docId, docData(docId));
          // The key list keeps `suggestion` out as well.
          allow create: if docData(docId).currentVersion == versionId && canRead(docId, docData(docId)) && authoredBySelf()
            && feedbackWritable(docData(docId))
            && isExactly(['annId', 'anchor', 'authorUid', 'authorEmail', 'actor', 'color', 'resolved', 'createdAt'])
            && request.resource.data.anchor is map
            && request.resource.data.resolved == false
            && request.resource.data.createdAt == request.time;
          // Readers may only toggle `resolved`, saying who they are in
          // `resolvedBy`, which is what the change log reports; nothing else
          // changes with it: not the author, anchor, colour, actor or
          // createdAt, and no field added on the side.
          allow update: if docData(docId).currentVersion == versionId && canRead(docId, docData(docId))
            && feedbackWritable(docData(docId))
            && !('suggestion' in resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved', 'resolvedBy'])
            && request.resource.data.resolved is bool
            && request.resource.data.resolvedBy.keys().hasOnly(['uid', 'email', 'channel'])
            && request.resource.data.resolvedBy.uid == request.auth.uid
            && request.resource.data.resolvedBy.email == myEmail()
            && request.resource.data.resolvedBy.channel == 'web';
          allow delete: if docData(docId).currentVersion == versionId && isVerifiedUser()
            && feedbackWritable(docData(docId))
            && resource.data.authorUid == request.auth.uid
            && !('suggestion' in resource.data);

          // `generated` and `opensSuggestion` mark what the server wrote for a
          // suggestion; a client claiming either would be passing its words off
          // as the server's. Nor may it change or remove one afterwards: each
          // is stamped with the person it speaks for, so "its author may edit
          // it" would let an approver erase "Accepted.", and a suggester
          // rewrite an opener outside the revision history the server keeps.
          match /comments/{commentId} {
            allow read: if canRead(docId, docData(docId));
            // The key list is what keeps `generated` and `opensSuggestion` out.
            allow create: if docData(docId).currentVersion == versionId && canRead(docId, docData(docId)) && authoredBySelf()
              && feedbackWritable(docData(docId))
              && isExactly(['commentId', 'body', 'authorUid', 'authorEmail', 'actor', 'createdAt'])
              && request.resource.data.body is string
              && request.resource.data.createdAt == request.time;
            // Its author may reword it, and that is all: when it was written,
            // and by whom, stay as they were.
            allow update: if docData(docId).currentVersion == versionId && canRead(docId, docData(docId))
              && feedbackWritable(docData(docId))
              && resource.data.authorUid == request.auth.uid
              && !('generated' in resource.data)
              && !('opensSuggestion' in resource.data)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body'])
              && request.resource.data.body is string;
            allow delete: if docData(docId).currentVersion == versionId && isVerifiedUser()
              && feedbackWritable(docData(docId))
              && resource.data.authorUid == request.auth.uid
              && !('generated' in resource.data)
              && !('opensSuggestion' in resource.data);
          }
        }
      }
    }

    // --- Public projection (SPEC §17) -------------------------------------
    // Firestore rules cannot project fields, so "anonymous may read a public
    // doc" cannot be an exception carved into the docs/{docId} rule without
    // handing the world `members`, `viewers`, `ownerEmail` and `stats`.
    // Instead the server mirrors ONLY the render fields of a PUBLIC document
    // here, and deletes the mirror the instant it stops being public. The rules
    // that protect everything else stay exactly as they were.
    //
    // `get` only, and only a public row. An absent id and any row that is not
    // public — a stale mirror of a document since made unlisted — are then the
    // same refusal, so this collection cannot confirm that an id exists.
    // `list` is refused outright: listing it once enumerated every unlisted
    // document's id and title. The sitemap lists it through the Admin SDK.
    match /public/{docId} {
      allow get: if resource != null && resource.data.visibility == 'public';
      allow list: if false;
      allow write: if false;
    }

    // --- Forks (SPEC §21) -------------------------------------------------
    // Which document a fork was made from. Server-only, like a link grant: a
    // docId is the slug of a title, so a client that could read this would
    // learn the original's address from a fork it was merely shared — an
    // unlisted original's included. POST /fork answers lineage one hop at a
    // time, and only for hops the caller could open.
    match /forks/{forkId} {
      allow read, write: if false;
    }

    // --- Folders (SPEC §13) -----------------------------------------------
    // Sharing containers that nest. Effective `members` is denormalized
    // server-side (self + every ancestor's grants), so read/list mirror docs.
    match /folders/{folderId} {
      allow get: if isMember(resource.data);
      allow list: if isVerifiedUser()
        && request.auth.token.email in resource.data.members;
      allow write: if false; // createFolder / setFolderAccess / organize
    }

    // --- Teams (SPEC §18) --------------------------------------------------
    // A team is an access grant, never a principal: documents always have a
    // person as owner. `team:{id}` entries in a doc's viewers/editors are
    // expanded server-side into the flat `members` array above, so nothing here
    // participates in the doc read path.
    match /teams/{teamId} {
      allow get: if isVerifiedUser() && myEmail() in resource.data.members;
      allow list: if isVerifiedUser()
        && request.auth.token.email in resource.data.members;
      allow write: if false; // POST /team, POST /team-members
    }

    // --- Accounts (SPEC §14) ----------------------------------------------
    // Self-only. The client may set its own profile and preferences; anything
    // that gates access — email cooldowns, personal access tokens — is
    // server-written and unwritable here, so a user cannot clear their own rate
    // limit. `verification` stays unwritable: it is where a code was kept
    // before 0.29.1, and nothing may put one back.
    match /users/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create: if isVerifiedUser()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == myEmail()
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'photoURL', 'providers',
          'emailNotifications', 'analyticsOptOut', 'defaultMarking',
          'createdAt', 'updatedAt'
        ]);
      allow update: if isVerifiedUser()
        && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['uid', 'email', 'verification', 'emailCooldowns', 'createdAt']);
      allow delete: if false;

      // Personal access tokens (SPEC §19). Metadata is readable by the owner so
      // the account screen can list and revoke; the hash is never stored here.
      match /tokens/{tokenId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false; // minted and revoked through POST /tokens
      }
    }

    // --- Verification challenges (SPEC §14) ------------------------------
    // Server-only, its own account included. A six-digit code's hash is the
    // code to whoever can read it — a million guesses take under a second —
    // so it lives here, never on `users/{uid}`, which its account may read.
    // Kept there until 0.29.1, it let an account verify an address it did not
    // own. The catch-all below refuses this too; the block says why.
    match /verifications/{uid} {
      allow read, write: if false; // POST /verify/start, POST /verify/complete
    }

    // --- Account moves (SPEC §14, ADR 0020) ------------------------------
    // The job that moves an account to the address Google renamed it to. Its
    // own account watches it to know when to sign in again, and may not list
    // anyone else's: a job names two addresses. Only the server writes.
    match /accountMoves/{jobId} {
      allow get: if request.auth != null && resource.data.uid == request.auth.uid;
      allow list, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
